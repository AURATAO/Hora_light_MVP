{
  "expo": {
    "name": "HO:RA",
    "slug": "hora",
    "scheme": "hora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.horaapp.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "co.horaapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "HO:RA records your location while you are clocked in on a task so requesters can track progress and work time can be verified.",
          "locationAlwaysAndWhenInUsePermission": "HO:RA records your location while you are clocked in on a task so requesters can track progress and work time can be verified.",
          "locationAlwaysPermission": "HO:RA records your location while you are clocked in on a task so requesters can track progress and work time can be verified."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HO:RA needs access to your photos to attach a completion photo.",
          "cameraPermission": "HO:RA needs camera access to take a completion photo."
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "../../node_modules/@notifee/react-native/android/libs"
            ]
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3A5A2D",
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "62e83efc-f12f-403c-b973-3fd5349e8c01"
      }
    },
    "owner": "taoaura"
  }
}
