{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "extends": "development",
      "environment": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true
    }
  },
  // Submit profiles are matched to the build profile by name. Without a
  // "preview" entry here, submitting a preview build silently falls back to
  // "production", which does not exist, and fails asking for ascAppId.
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6795529693"
      }
    }
  }
}
