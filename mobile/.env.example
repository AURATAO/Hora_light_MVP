EXPO_PUBLIC_SUPABASE_URL=https://akxsdkerudurzcemurrb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Same value as web's VITE_TALKJS_APP_ID (app/.env) — the app ID is not a
# secret. The TalkJS secret key lives only in server/.env (TALKJS_SECRET_KEY),
# never here — see GET /talkjs/signature.
EXPO_PUBLIC_TALKJS_APP_ID=your_talkjs_app_id_here

# Powers address autocomplete in Post Task (src/lib/places.ts → src/components/
# AddressField.tsx) via the Places API (New) REST endpoints, called with plain
# fetch() — no native SDK. Get a key from https://console.cloud.google.com/apis/credentials
# with the "Places API (New)" enabled — reuse the same Google Cloud project as
# app/'s VITE_GOOGLE_MAPS_API_KEY (app/.env) if you want one key for both clients,
# or mint a separate one restricted to this app's bundle ID / package name.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=your_places_api_key_here

# If you restrict the key to iOS apps, src/lib/places.ts sends the required
# X-Ios-Bundle-Identifier header itself (fetch, unlike the native SDK, carries no
# app identity). Android app-restriction additionally needs the signing SHA-1
# (X-Android-Cert), which JS can't read — restrict the Android key by API only.

# QA-only: forces the Traction 3 round-scoped surfaces open regardless of
# today's date (src/lib/beta-notice.ts isTractionWindowActive). Set to 1 in a
# local mobile/.env to exercise the post-task questionnaire before the window
# opens. Leave it unset/absent everywhere else — EXPO_PUBLIC_* is inlined at
# bundle time, so a release build simply never sees it.
# EXPO_PUBLIC_QA_FORCE_TRACTION=1
