# EAS archives from the git repo root, so this file lives here rather than in
# mobile/. Without it the tarball is 198 MB — ~125 MB of that is large tracked
# files under server/ (a Go installer .pkg and two compiled binaries) — and the
# upload dies with EPIPE partway through.
#
# The iOS build only needs mobile/, which has its own package.json and app.json
# and never reads a sibling directory. This affects the build archive only and
# changes nothing about what git tracks.
/server
/app
/supabase
/skills
/design-tokens
/.agents

# Generated locally; regenerated by prebuild or unused by the build.
mobile/ios
mobile/android
mobile/dist
mobile/.expo

# .git is 107 MB on its own — the same server/ binaries are in the history, and
# history is not reachable from a .easignore. The builder only needs a working
# tree, so excluding it takes the archive from 100 MB to ~2 MB.
.git
